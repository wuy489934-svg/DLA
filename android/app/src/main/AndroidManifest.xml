<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 📂 本机文件浏览：按真实路径读文件（Android 11+ 用「所有文件访问权限」，
         10 及以下退回读存储权限）。不再需要麦克风权限：语音输入入口已删除。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Agent：后台运行前台服务 + 通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 长任务期间请求忽略电池优化，避免 MIUI 把前台服务一起清掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 列出全部应用（模型需要「应用名 | 包名」来打开应用）；仅侧载/自用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Termux RUN_COMMAND：在 Termux 环境执行命令 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:theme="@style/ViewerTheme" />

        <!-- 原生 Compose 壳（方案 B）：默认入口；网页界面降级为可选外壳 -->
        <activity
            android:name=".nativeui.NativeShellActivity"
            android:exported="true"
            android:theme="@style/NativeTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Agent 运行期间保活；循环本身在 AgentRuntime 线程里 -->
        <service
            android:name=".agent.AgentService"
            android:process=":agent"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本地 Agent 长时任务执行" />
        </service>

        <!-- 接收 Termux RUN_COMMAND 结果 -->
        <service
            android:name=".agent.TermuxResultService"
            android:process=":agent"
            android:exported="false" />

        <!-- 开机/升级后恢复未完成 Agent 任务 -->
        <receiver
            android:name=".agent.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 15 分钟健康检查（由 AlarmManager 显式触发） -->
        <receiver
            android:name=".agent.HealthReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 进程内读屏服务；不 fork uiautomator -->
        <service
            android:name=".agent.ChatDemoAccessibilityService"
            android:process=":agent"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Shizuku：提供 shell 权限的 binder 服务 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 把缓存里的附件以 content:// 交给系统图片/PDF 应用打开 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
